# Normalize line endings: source and scripts are LF everywhere.
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf
*.rs        text eol=lf
*.cs        text eol=lf
*.js        text eol=lf
*.cjs       text eol=lf
*.mjs       text eol=lf
*.ts        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.cmake     text eol=lf
CMakeLists.txt text eol=lf

*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

*.png       binary
*.jpg       binary
*.wasm      binary
*.a         binary
*.lib       binary
*.dll       binary
*.so        binary
*.dylib     binary
